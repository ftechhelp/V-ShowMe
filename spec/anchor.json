{
  "about": "Shared behaviour spec for re-locating a step's lines with its anchor. Inputs are hand-written; every `expect` is generated by `node scripts/update-spec.mjs`.",
  "docs": {
    "login": [
      "import x from \"y\";",
      "",
      "export function login(req) {",
      "  const user = find(req.email);",
      "  return user;",
      "}",
      "",
      "export function logout() {}"
    ],
    "repeated": [
      "a",
      "return user;",
      "b",
      "c",
      "d",
      "e",
      "return user;",
      "f"
    ],
    "empty": []
  },
  "resolveRange": [
    {
      "name": "anchor matches",
      "doc": "login",
      "start": 3,
      "end": 6,
      "anchor": "export function login(",
      "expect": {
        "start": 3,
        "end": 6
      }
    },
    {
      "name": "whitespace differences",
      "doc": "login",
      "start": 4,
      "end": 5,
      "anchor": "const user   =  find(req.email);",
      "expect": {
        "start": 4,
        "end": 5
      }
    },
    {
      "name": "drifted down",
      "doc": "login",
      "start": 1,
      "end": 4,
      "anchor": "export function login(",
      "expect": {
        "start": 3,
        "end": 6
      }
    },
    {
      "name": "drifted up",
      "doc": "login",
      "start": 7,
      "end": 7,
      "anchor": "export function logout(",
      "expect": {
        "start": 8,
        "end": 8
      }
    },
    {
      "name": "nearest occurrence below",
      "doc": "repeated",
      "start": 6,
      "end": 6,
      "anchor": "return user;",
      "expect": {
        "start": 7,
        "end": 7
      }
    },
    {
      "name": "nearest occurrence above",
      "doc": "repeated",
      "start": 3,
      "end": 3,
      "anchor": "return user;",
      "expect": {
        "start": 2,
        "end": 2
      }
    },
    {
      "name": "tie goes to the first occurrence",
      "doc": "repeated",
      "start": 5,
      "end": 5,
      "anchor": "return user;",
      "expect": {
        "start": 7,
        "end": 7
      }
    },
    {
      "name": "anchor not found",
      "doc": "login",
      "start": 3,
      "end": 4,
      "anchor": "does not exist",
      "expect": {
        "start": 3,
        "end": 4,
        "warning": "Anchor \"does not exist\" not found in file; using lines 3-4 as given."
      }
    },
    {
      "name": "anchor with quotes in the warning",
      "doc": "login",
      "start": 3,
      "end": 4,
      "anchor": "say \"hi\"\\n",
      "expect": {
        "start": 3,
        "end": 4,
        "warning": "Anchor \"say \\\"hi\\\"\\\\n\" not found in file; using lines 3-4 as given."
      }
    },
    {
      "name": "multi-line anchor uses its first non-blank line",
      "doc": "login",
      "start": 1,
      "end": 2,
      "anchor": "\n   \r\n  return user;\r\n}",
      "expect": {
        "start": 5,
        "end": 6
      }
    },
    {
      "name": "blank anchor is ignored",
      "doc": "login",
      "start": 2,
      "end": 3,
      "anchor": "   ",
      "expect": {
        "start": 2,
        "end": 3
      }
    },
    {
      "name": "past the end of the file",
      "doc": "login",
      "start": 20,
      "end": 22,
      "expect": {
        "start": 6,
        "end": 8,
        "warning": "Lines 20-22 are past the end of the file (8 lines)."
      }
    },
    {
      "name": "end past the end of the file",
      "doc": "login",
      "start": 7,
      "end": 50,
      "expect": {
        "start": 7,
        "end": 8
      }
    },
    {
      "name": "anchor not found and past the end",
      "doc": "login",
      "start": 30,
      "end": 31,
      "anchor": "nope",
      "expect": {
        "start": 7,
        "end": 8,
        "warning": "Anchor \"nope\" not found in file; using lines 30-31 as given. Lines 30-31 are past the end of the file (8 lines)."
      }
    },
    {
      "name": "empty document",
      "doc": "empty",
      "start": 1,
      "end": 3,
      "expect": {
        "start": 1,
        "end": 1
      }
    },
    {
      "name": "drift beyond the end",
      "doc": "login",
      "start": 8,
      "end": 12,
      "anchor": "export function login(",
      "expect": {
        "start": 3,
        "end": 7
      }
    }
  ]
}
